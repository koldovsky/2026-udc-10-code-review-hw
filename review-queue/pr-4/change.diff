+import test from "node:test";
+import assert from "node:assert/strict";
+import { addDays, daysBetween, toUtcMs } from "../src/dates.js";
+
+test("addDays crosses month and year ends", () => {
+  assert.equal(addDays("2026-12-25", 14), "2027-01-08");
+  assert.equal(addDays("2026-02-20", 14), "2026-03-06");
+});
+
+test("daysBetween is negative when the second date is earlier", () => {
+  assert.equal(daysBetween("2026-10-08", "2026-10-01"), -7);
+});
+
+test("toUtcMs ignores the local time zone", () => {
+  assert.equal(new Date(toUtcMs("2026-10-08")).toISOString(), "2026-10-08T00:00:00.000Z");
+});
