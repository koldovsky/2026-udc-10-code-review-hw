+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { createDb } from "../src/db.js";
+import { importMembersFromUpload } from "../src/imports.js";
+import { AccessDenied } from "../src/auth.js";
+
+const admin = { id: 4, role: "admin" };
+
+function uploads() {
+  const dir = mkdtempSync(path.join(tmpdir(), "uploads-"));
+  writeFileSync(path.join(dir, "new-members.csv"), "name,email,phone\nНова Учасниця,new1@example.invalid,+380000000010\nНовий Учасник,new2@example.invalid,+380000000011\n");
+  return dir;
+}
+
+test("an admin imports members from an uploaded CSV", async () => {
+  const db = createDb();
+  const res = await importMembersFromUpload(db, admin, "new-members.csv", { uploadDir: uploads() });
+  assert.equal(res.added, 2);
+  assert.equal(db.members.length, 7);
+  assert.equal(db.members[6].email, "new2@example.invalid");
+});
+
+test("only an admin may import", async () => {
+  await assert.rejects(importMembersFromUpload(createDb(), { id: 3, role: "librarian" }, "new-members.csv", { uploadDir: uploads() }), AccessDenied);
+});
